# Telegram bot polling for personal use
# You can edit this file directly for first-time setup.
# Runtime loads .env first and falls back to .env.example when .env is missing.
# Fill TG_BOT_TOKEN and either use explicit chat ids or temporary * during first-time debugging.
TG_BOT_TOKEN=
TG_ALLOWED_CHAT_IDS=
TG_DEFAULT_CHAT_ID=
TG_API_BASE_URL=https://api.telegram.org
TG_POLL_INTERVAL_MS=1000
TG_LONG_POLL_TIMEOUT_SEC=20
TG_COMMAND_DISPATCH_MODE=async
TG_MAX_MESSAGE_LENGTH=3500

# Runtime persistence
CODEX_PUPPETEER_STORAGE_DIR=.agent/runtime
CODEX_PUPPETEER_ENV_FILES=.env,.env.example
# Comma-separated allowed project root prefixes for explicit /create -w <path> usage
# Example on Windows: F:\project,D:\workspace
CODEX_PUPPETEER_ALLOWED_PROJECT_ROOTS=F:\project
# Remote Codex execution policy
# manual + safe: keep Codex approval behavior
# auto + dangerous: bypass approvals and sandbox entirely; recommended for this remote-control bot on trusted hosts
# auto + full-auto: keeps auto-approve behavior but still stays inside the selected sandbox
# dangerous: bypass approvals and sandbox entirely; use only on trusted hosts
CODEX_PUPPETEER_DEFAULT_PERMISSION_MODE=manual
CODEX_PUPPETEER_CODEX_EXEC_PROFILE=safe
CODEX_PUPPETEER_CODEX_AUTO_PERMISSION_PROFILE=dangerous
# Optional sandbox override for safe/full-auto profiles: read-only | workspace-write | danger-full-access
# CODEX_PUPPETEER_CODEX_SANDBOX=workspace-write
# Wait settings for remote /send. Increase if long coding tasks still reply too early.
CODEX_PUPPETEER_WAIT_TIMEOUT_MS=120000
CODEX_PUPPETEER_SEND_WAIT_TIMEOUT_MS=3600000

# System action mode
# Keep dry-run until you are ready to let the host really shut down.
CODEX_PUPPETEER_SYSTEM_MODE=dry-run
# Optional explicit persistence files
# CODEX_PUPPETEER_SESSIONS_FILE=.agent/runtime/sessions.json
# CODEX_PUPPETEER_TASKS_FILE=.agent/runtime/tasks.json
# CODEX_PUPPETEER_SOURCE_BINDINGS_FILE=.agent/runtime/source-bindings.json
